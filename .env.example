# Abidjan Digital Twin - configuration template
# Copy to .env and adjust. Never commit your real .env.

# --- Storage infrastructure (docker-compose default values) ---
POSTGRES_PASSWORD=adt_dev_password
MINIO_ROOT_USER=adt
MINIO_ROOT_PASSWORD=adt_dev_password
REDIS_URL=redis://redis:6379/0

# --- Backend ---
ADT_DATA_DIR=/app/data/processed
ADT_MODEL_DIR=/app/ai/traffic/models
ADT_SUMO_BIN=sumo

# Headless SUMO on hosts without X11 libraries, install the system packages
# libx11-6 libxext6 libxrender1 libgl1 (see README).

# --- Future / optional ---
# WAZE_PARTNER_TOKEN=
# TOMTOM_API_KEY=
